# ==============================================================================
# Aplikasi Kanomas - Hostinger Web Server Configuration (.htaccess)
# Designed for LiteSpeed & Apache on Hostinger (hPanel)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Pastikan selalu menggunakan HTTPS aman (SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. SPA Single Page Application Routing (React Vite)
  # Jika file atau folder fisik tidak ditemukan, arahkan ke index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Directory default
DirectoryIndex index.html

# MIME Types untuk Audio MP3, PWA Manifest, dan Webfonts
<IfModule mod_mime.c>
  AddType audio/mpeg .mp3
  AddType application/manifest+json .json .webmanifest
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
</IfModule>

# ==============================================================================
# Browser & CDN Caching Policy (Instant HTML Updates, Fast Media Caching)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"

  # HTML: Never cache HTML documents to ensure changes are instant
  ExpiresByType text/html "access plus 0 seconds"

  # Media: Audio MP3, Images, Icons, Video (1 year)
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Webfonts (1 year)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # CSS / JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ==============================================================================
# Security Headers & Hardening
# ==============================================================================
# Disable directory listing
Options -Indexes

<IfModule mod_headers.c>
  # CORS Policy for Mobile Apps (Capacitor https://localhost) & Web
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS, HEAD"
  Header always set Access-Control-Allow-Headers "*"

  # Pastikan file JSON (version.json), Service Worker (sw.js), dan APK selalu fresh & bebas CORS
  <FilesMatch "(sw\.js|\.json|\.apk)$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, OPTIONS, HEAD"
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Pastikan file HTML dan root tidak pernah dicache browser
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Enforce MIME-type sniffing protection
  Header set X-Content-Type-Options "nosniff"

  # Prevent Clickjacking
  Header set X-Frame-Options "SAMEORIGIN"

  # Legacy XSS Filter for older browsers
  Header set X-XSS-Protection "1; mode=block"

  # Protect referrer data privacy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
